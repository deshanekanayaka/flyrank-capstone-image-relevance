# Provider. One implementation is built. "fake" is for tests and needs no key.
VISION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Model names are pinned. Every ai_calls row records the name that served the call.
VISION_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2-preview

GEMINI_API_KEY=your-ai-studio-key-here

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/image_relevance

# A tag set below this vision confidence is flagged and can never reach ACCEPT.
LOW_CONFIDENCE_THRESHOLD=0.60

# Two floors, because three decisions need two cut points.
# At or above ACCEPT_FLOOR: ACCEPT. Between the two: REVIEW. Below REVIEW_FLOOR: REJECT.
# Placeholder values. The eval script prints the tuned pair, which replaces these with a
# comment naming the run that produced them.
ACCEPT_FLOOR=0.45
REVIEW_FLOOR=0.30

# When the month of notional cost reaches this, the next model call is refused with 429.
MONTHLY_BUDGET_USD=5.00
